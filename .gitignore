# ── Secrets — never commit ──────────────────────────────────────────────────
# Real settings live in Railway → Variables (production) and backend/.env or
# frontend/.env (your own computer). Only the documented examples are tracked.
.env
.env.*
*.env
!.env.example
!**/.env.example
credentials.json
*credentials.json*
*token.json*
*.pem
*.key
*.har
backend/secrets/

# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.js

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/

# ── Builds and caches ──────────────────────────────────────────────────────
dist/
web-dist/
/build
/coverage
*.tsbuildinfo
.cache/
frontend/.expo/
frontend/.metro-cache/
frontend/web-build/

# ── Logs, archives, OS and editor files ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dump.rdb
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
.DS_Store
.idea/

# Claude Code: personal settings stay on your machine (project skills in .claude/skills are shared)
.claude/settings.local.json
