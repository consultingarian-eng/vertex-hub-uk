{
  "expo": {
    "name": "Vertex Hub",
    "slug": "vertex-hub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "vertexhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.vertexhub",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a profile photo for your account",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo from your library",
        "NSUserNotificationsUsageDescription": "Receive assessment updates and team notifications",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.vertexhub",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#102d25"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "backgroundColor": "#f0f4e9",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0b211c"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#244c3b",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "This app does not currently record audio. If a feature ever asks to use the microphone, it will only do so after you choose to turn it on.",
          "enableBackgroundRecording": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "exposdk:54.0.0",
    "extra": {
      "router": {}
    }
  }
}
