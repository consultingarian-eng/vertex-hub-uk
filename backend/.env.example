# ─────────────────────────────────────────────────────────────────────────────
# Backend settings (environment variables)
#
# On your computer: copy this file to backend/.env and fill in what you need.
# On Railway: add the same names under your service → Variables.
#
# NEVER commit a real value. backend/.env is already ignored by git. Anything
# marked SECRET is "set your own; no default": generate or copy it from the
# provider, paste it straight into Railway, and never paste it into a chat,
# screenshot, issue or commit.
#
# Only the "Required" block is needed to start. Every other feature stays off
# until its block is filled in. docs/SETUP.md and docs/SERVICES.md explain each
# service; docs/OWNERIQ.md and docs/BRANDING.md cover those two in depth.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# SECRET. MongoDB connection string (it contains your database password).
# Atlas → your cluster → Connect → Drivers → copy the mongodb+srv://… string.
# Locally you can use mongodb://localhost:27017 if you run MongoDB yourself.
MONGO_URL=
# Database name inside that cluster, e.g. fieldapp (live) and fieldapp_dev
# (your computer). Always set it: without it the app uses a database called
# test_database (one default, in backend/database.py). Never share one
# database between two deployments.
DB_NAME=
# SECRET. Signs everyone's logins. At least 32 random characters, or the server
# refuses to start. Generate one with:
#   Mac:     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   Windows: py -3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later logs everybody out.
JWT_SECRET=
# Your super-admin login. Used ONCE, when the account is first created; after
# that, change the password in the app (Profile → Change password). A restart
# never resets it. Both must be set or no admin is created (a warning is
# logged).
ADMIN_EMAIL=
# SECRET.
ADMIN_PASSWORD=
# Recovery only, for when you've forgotten the owner password and have no email
# set up ("Forgot password" needs SendGrid). Set ADMIN_PASSWORD to a NEW
# password, set this to true for ONE deploy, log in, then remove it. On the
# next start it sets the existing super-admin's password to ADMIN_PASSWORD (and
# ends their sessions). ADMIN_EMAIL must be your login email. See
# docs/SETUP.md, "Locked out of the owner account".
ADMIN_PASSWORD_RESET=
# Display name for the super-admin. Optional, default "Admin".
ADMIN_NAME=
# Name of the one office created on the very first start (with the default day
# targets and training manual). Optional, default "Head Office". Only read when
# the database has no offices yet, so set it before your first deploy. Add more
# offices later in the app (Admin → Offices).
SEED_OFFICE_NAME=
# Public address of your deployment, e.g. https://app.yourdomain.co.uk (no
# trailing slash). Used for links and the logo in emails, profile-photo links
# and the web-push contact. Recommended once your domain works; without it,
# links fall back to the address the request came in on.
APP_BASE_URL=
# Exact browser origins allowed to call the API from ANOTHER address,
# comma-separated, no "*". Leave blank when the backend serves the web app
# itself (the normal Railway set-up). On a local run, blank also allows the
# Expo dev ports (localhost:8081 / 19006); on Railway (RAILWAY_ENVIRONMENT is
# set) or with APP_ENV=production, blank allows nothing extra.
CORS_ALLOWED_ORIGINS=
# Set to production when hosting somewhere other than Railway, so localhost
# dev origins are never trusted. Optional.
APP_ENV=

# ── Locale ───────────────────────────────────────────────────────────────────
# Time zone for every "today", week boundary, quiet-hours window and scheduled
# job (the server clock is ignored). Optional, default Europe/London (handles
# GMT/BST). The app screens have their own copy (frontend/src/utils/appTime.ts,
# EXPO_PUBLIC_APP_TIMEZONE at build time): change both together or not at all.
APP_TIMEZONE=

# ── Branding (see docs/BRANDING.md) ──────────────────────────────────────────
# Product name in emails, the /launch page, push notifications and AI-written
# text. Optional, default "Vertex Hub". The screens read their own copy in
# frontend/src/theme/brand.ts, so change both.
APP_NAME=
# Your organisation's name (email footers, badge "authorised by" default, AI
# prompts). Optional, default "Vertex Organisation".
ORG_NAME=

# ── Email: SendGrid (optional, recommended) ──────────────────────────────────
# Welcome emails with first-login details, email verification codes, password
# resets, new-starter and advancement emails. Without the key AND a verified
# sender, no email is sent (it is logged and skipped).
# SECRET. app.sendgrid.com → Settings → API Keys (Mail Send permission is enough).
SENDGRID_API_KEY=
# The address emails come from. Must be verified in SendGrid → Settings →
# Sender Authentication (a single sender, or better, your whole domain).
SENDGRID_FROM_EMAIL=
# The sender name people see in their inbox, e.g. your organisation. Optional.
SENDGRID_FROM_NAME=

# ── OwnerIQ (optional; see docs/OWNERIQ.md) ──────────────────────────────────
# Field KPIs, Live Operations, the Performance Hub, the Timeline, Bells
# auto-fill, the spider diagram's stages, and the people sync. Both login values are
# required for any OwnerIQ feature; leave them blank and it all stays off.
# Use an OwnerIQ OWNER login (the one you use at owner-iq.ai).
OWNERIQ_EMAIL=
# SECRET.
OWNERIQ_PASSWORD=
# OwnerIQ API host. Optional, default https://us.owner-iq.ai. If your account
# lives on a different regional host, OwnerIQ support can tell you which.
OWNERIQ_API_BASE=
# Marketing-company pins to sync, comma-separated. Optional: blank syncs every
# company your login can see (found automatically).
OWNERIQ_MC_PINS=
# Which OwnerIQ company each app office is: "Office Name=PIN,Other Office=PIN".
# Optional: with one company, every office maps to it; otherwise offices are
# matched to companies with exactly the same name.
OWNERIQ_OFFICE_PINS=
# OwnerIQ user ids that sit at the top of your OwnerIQ tree but are NOT an
# office owner (e.g. an agency or platform account), comma-separated. Skipped
# when the people sync looks for each office's owner. Optional.
OWNERIQ_ROOT_USER_IDS=
# Lets the app WRITE to OwnerIQ (stages, deactivations, coach lines, teams)
# and lets the people sync apply changes. Optional, default off. Leave it off
# until you have read docs/OWNERIQ.md and checked the dry run.
OWNERIQ_WRITES_ENABLED=
# Seconds today's Live Operations data is cached before OwnerIQ is asked
# again. Optional, default 60.
OWNERIQ_LIVE_TTL=
# SECRET. Turns on a no-login roster comparison page at
# /public/roster/<this value> (OwnerIQ active reps vs active app accounts).
# Optional: blank = the page does not exist. At least 32 characters, or the
# page stays off. Generate one with
#   Mac:     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   Windows: py -3 -c "import secrets; print(secrets.token_urlsafe(32))"
ROSTER_SHARE_TOKEN=

# ── AI: Anthropic Claude (optional) ──────────────────────────────────────────
# AI reports, the coaching assistant, the monthly planner coach, the Bells
# daily breakdown, COD and coaching-impact quizzes, and reading photos of
# schedules and planner notes. Blank = those features show as off; everything
# else works without it.
# SECRET. console.anthropic.com → API Keys. Set a monthly spend limit there.
# (The older name EMERGENT_LLM_KEY is still read as a fallback for this key.)
ANTHROPIC_API_KEY=
# Older name for the same key, read only when ANTHROPIC_API_KEY is blank.
# EMERGENT_LLM_KEY=
# The model id every AI feature uses: the only place a model is chosen.
# Optional, default claude-sonnet-5-5 (FALLBACK_MODEL in
# backend/emergentintegrations/llm/chat.py). When Anthropic retires a model,
# change this; no code change is needed.
ANTHROPIC_MODEL=
# A different model only for reading photos of schedules and planner notes.
# Optional; blank = ANTHROPIC_MODEL.
ANTHROPIC_VISION_MODEL=
# Output token cap per AI call. Optional, default 8192.
ANTHROPIC_MAX_TOKENS=
# How many AI calls may run at once before people see a friendly "busy".
# Optional, default 4.
LLM_MAX_CONCURRENCY=
# AI requests one person may make per hour, across every AI feature. Optional,
# default 60. Keep a spend limit on the key as well.
AI_HOURLY_LIMIT_PER_USER=

# ── Push notifications for the installed web app (optional) ──────────────────
# A VAPID key pair, generated once with:  npx web-push generate-vapid-keys
# Blank = no web push (in-app Inbox still works).
VAPID_PUBLIC_KEY=
# SECRET.
VAPID_PRIVATE_KEY=
# Contact push services can reach: "mailto:you@yourdomain.co.uk" or an https
# address. Optional: falls back to APP_BASE_URL, then SENDGRID_FROM_EMAIL.
VAPID_SUBJECT=

# ── Photo storage: any S3-compatible bucket (optional) ───────────────────────
# Profile photos and ID-badge photos (Cloudflare R2, AWS S3, …). All four of
# endpoint, bucket and both keys must be set; otherwise photos are kept inside
# MongoDB, which works but makes the database grow faster.
# e.g. https://<account id>.r2.cloudflarestorage.com
CI_S3_ENDPOINT=
CI_S3_BUCKET=
CI_S3_ACCESS_KEY_ID=
# SECRET.
CI_S3_SECRET_ACCESS_KEY=
# Region. Optional, default "auto" (right for R2).
CI_S3_REGION=

# ── ID badges (optional) ─────────────────────────────────────────────────────
# Printed on every ID badge by Badge Studio (on the neutral template in
# frontend/assets/badges/, or your own approved artwork; see docs/BRANDING.md).
# Organisation the badge says the BA is authorised by. Optional, default ORG_NAME.
BADGE_ORG_NAME=
# Verification phone number a member of the public can call. Optional:
# blank = no number printed.
BADGE_VERIFY_PHONE=
# What each badge's QR code encodes, with {badge_number} replaced, e.g.
# https://yourdomain.co.uk/verify?badge={badge_number}. Optional: blank = the
# QR carries just the badge number.
BADGE_QR_URL_TEMPLATE=
# SECRET. Automatic background removal for badge photos (replicate.com →
# Account → API tokens). Optional: blank = the "remove background" button
# reports it isn't configured.
REPLICATE_API_TOKEN=

# ── Feature switches (optional) ──────────────────────────────────────────────
# Sales Development Path (levels, Green Weeks, ramp). Default off.
SALES_PATH_ENABLED=
# Limit it to these office ids, comma-separated. Blank = all offices.
SALES_PATH_OFFICES=
# Dates (YYYY-MM-DD) for the Sales Path: people who joined before the waiver
# date don't need COD sign-offs for levels; people who joined from the ramp
# date are graded on the ramp. Both default to 2026-09-15 in code; set your own
# launch date if you switch the Sales Path on.
SALES_PATH_ANCHOR_WAIVER_BEFORE=
SALES_PATH_RAMP_SINCE=
# SECRET. Shared password for the stand-alone training-manual editor page
# (/api/manual-editor), so someone without an account can edit the manual.
# Optional: blank = only signed-in admins can use it. At least 16 characters,
# or shared access stays off. 30 wrong tries in 15 minutes (from anywhere)
# lock it for everyone until the 15 minutes pass.
MANUAL_EDITOR_PASSWORD=

# ── Advanced ─────────────────────────────────────────────────────────────────
# Login cookies only over HTTPS. Default true. Set false ONLY in your local
# backend/.env (your computer has no HTTPS). Never false on Railway.
COOKIE_SECURE=
# REQUIRED true on Railway (or behind another proxy you trust). The visitor's
# address is then the RIGHT-MOST X-Forwarded-For entry, the one the proxy
# appends; entries to its left come from the visitor and are ignored. Without
# it every visitor looks like one address, so every per-address limit is
# shared: wrong logins, wrong Bells share codes or wrong roster links from
# anyone can lock EVERYONE out for 15 minutes. Left blank it is ON when the app
# runs on Railway and OFF everywhere else; the server logs a warning at boot if
# it is set to false on Railway. Never true locally.
TRUST_PROXY_HEADERS=
# How many proxies you control sit in front of the app (e.g. 2 for a CDN in
# front of Railway; set 2 if Cloudflare's proxy is on). Optional, default 1.
# Only read with TRUST_PROXY_HEADERS.
TRUSTED_PROXY_HOPS=
# Recovery switches: true skips importing the bundled content
# (backend/seed/*.json) or the additive manual/module repair on start. Leave
# blank normally.
DISABLE_SEED_LOADER=
DISABLE_SEED_HEAL=
# Where the built web app sits inside the container. The Dockerfile sets
# /app/web-dist; change only for a custom build layout.
WEB_DIST_PATH=
# Set automatically by Railway; used as the version the web app polls to show
# "Update ready". Don't set it yourself.
# RAILWAY_GIT_COMMIT_SHA=

# ── Not backend settings (for reference) ─────────────────────────────────────
# These belong in frontend/.env on your computer, never here:
#   EXPO_PUBLIC_BACKEND_URL=http://localhost:8000   (local dev only; the
#     Railway build leaves it empty so the app calls its own /api)
#   EXPO_PUBLIC_APP_TIMEZONE                         (build-time; default Europe/London)
